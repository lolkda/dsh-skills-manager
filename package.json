{
  "name": "@lolkda/dsh-skills-manager",
  "version": "0.2.0",
  "description": "Manage the DeepSeek Harness skill catalog from Settings: list what DSH actually resolves, enable or disable a skill by policy without touching its source file, read and edit SKILL.md, and create, import, or permanently delete skills.",
  "repository": { "type": "git", "url": "git+https://github.com/lolkda/dsh-skills-manager.git" },
  "homepage": "https://github.com/lolkda/dsh-skills-manager#readme",
  "bugs": "https://github.com/lolkda/dsh-skills-manager/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "spike": "node spike/registry-probe.mjs",
    "probe:session": "node spike/session-probe.mjs",
    "probe:lifecycle": "node spike/lifecycle-probe.mjs",
    "probe:project": "node spike/project-root-probe.mjs",
    "probe:client": "node spike/client-bundle-probe.mjs",
    "check": "node --check client/client.js && node --test",
    "probe:browser": "node spike/browser-probe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.2.0",
      "profiles": [
        "web"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "skills",
    "skill"
  ],
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-skill": ">=0.1.5-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
